[Unit]
Description=Memory-isolated Orbit BuildKit worker
Requires=docker.service orbit-builds.slice
After=docker.service orbit-builds.slice

[Service]
ExecStart=/usr/bin/docker start --attach orbit-buildkit
ExecStop=/usr/bin/docker stop --time 20 orbit-buildkit
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
