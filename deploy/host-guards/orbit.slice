# Parent cap for all heavy Orbit work (builds, Donna media, agent sandboxes).
# docs/agent-sandbox-design.md section 6. Leaves >= 3 GiB for Orbit, sidecar, nginx, page cache.
[Unit]
Description=Orbit heavy work (builds, media, agent sandboxes) together

[Slice]
MemoryAccounting=yes
MemoryHigh=11G
MemoryMax=12G
